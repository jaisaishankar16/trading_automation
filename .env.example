# Server Configuration
PORT=5000
FLASK_ENV=development
DEBUG=True

# Playwright Browser Configuration
# Set to 'false' to watch browser execution during debugging
HEADLESS=true

# Scraping & Anti-hammering Cooldown
REFRESH_COOLDOWN_SECONDS=60

# Scraper Retry Configuration
MAX_RETRIES=2
RETRY_DELAY_SECONDS=3

# Storage and Temp Paths (defaults to project-relative paths if empty)
# DATA_DIR=data
# TEMP_DIR=temp/nse_downloads

# Groq LLM API Configuration (for financial extraction fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
